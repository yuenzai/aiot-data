<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>cn.ecosync.aiot.data</groupId>
    <artifactId>aiot-data-apiserver-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>common</module>
        <module>api</module>
        <module>web</module>
        <module>kafka</module>
        <module>boot</module>
    </modules>

    <properties>
        <aiot-data-apiserver.version>0.0.1-SNAPSHOT</aiot-data-apiserver.version>
        <springdoc.version>2.7.0</springdoc.version>
        <swagger-api.version>2.2.25</swagger-api.version>
        <protobuf.version>4.30.0</protobuf.version>
        <snappy.version>1.1.10.5</snappy.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.ecosync.aiot.data</groupId>
                <artifactId>aiot-data-apiserver-common</artifactId>
                <version>${aiot-data-apiserver.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.ecosync.aiot.data</groupId>
                <artifactId>aiot-data-apiserver-api</artifactId>
                <version>${aiot-data-apiserver.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.ecosync.aiot.data</groupId>
                <artifactId>aiot-data-apiserver-web</artifactId>
                <version>${aiot-data-apiserver.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.ecosync.aiot.data</groupId>
                <artifactId>aiot-data-apiserver-kafka</artifactId>
                <version>${aiot-data-apiserver.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger-api.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
